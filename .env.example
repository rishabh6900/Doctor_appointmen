# Environment variables for AI Voice-Based Doctor Appointment Booking System

# Core Application Settings
PROJECT_NAME="AI Voice Doctor Appointment Booking"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Clinic Configuration
CLINIC_TIMEZONE="America/New_York"
CLINIC_NAME="CarePoint Health Medical Clinic"
CLINIC_PHONE="+1-800-555-0199"
DEFAULT_PHONE_REGION="US"
CLINIC_OPEN_TIME="09:00"
CLINIC_CLOSE_TIME="17:00"
DEFAULT_SLOT_DURATION_MIN=30

# Database Configuration
DATABASE_URL="sqlite:///./appointments.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security
REST_API_KEY=""

# AI Provider API Keys (Required for Phase 4 Voice Pipeline)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
